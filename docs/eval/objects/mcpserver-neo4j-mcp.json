{
 "apiVersion": "kagent.dev/v1alpha1",
 "kind": "MCPServer",
 "metadata": {
  "name": "neo4j-mcp",
  "namespace": "kagent"
 },
 "spec": {
  "deployment": {
   "cmd": "/app/neo4j-mcp",
   "env": {
    "NEO4J_MCP_DATABASE": "neo4j",
    "NEO4J_MCP_PASSWORD": "abox-neo4j",
    "NEO4J_MCP_READ_ONLY": "false",
    "NEO4J_MCP_TELEMETRY": "false",
    "NEO4J_MCP_URI": "bolt://neo4j.neo4j:7687",
    "NEO4J_MCP_USERNAME": "neo4j"
   },
   "image": "neo4j/mcp:v1.6.0",
   "port": 3000,
   "replicas": 1,
   "resources": {
    "limits": {
     "cpu": "500m",
     "memory": "256Mi"
    },
    "requests": {
     "cpu": "50m",
     "memory": "64Mi"
    }
   }
  },
  "stdioTransport": {},
  "timeout": "30s",
  "transportType": "stdio"
 }
}