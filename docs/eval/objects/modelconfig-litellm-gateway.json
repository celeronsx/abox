{
 "apiVersion": "kagent.dev/v1alpha2",
 "kind": "ModelConfig",
 "metadata": {
  "name": "litellm-gateway",
  "namespace": "kagent"
 },
 "spec": {
  "apiKeySecret": "litellm-gateway-key",
  "apiKeySecretKey": "OPENAI_API_KEY",
  "model": "claude-sonnet-5",
  "openAI": {
   "apiFormat": "chatCompletions",
   "baseUrl": "https://litellm.betterme.world/v1"
  },
  "provider": "OpenAI"
 }
}